{
  "name": "ATLAS",
  "label": "Atlas",
  "description": "开源数据治理与元数据管理框架",
  "version": "2.4.0",
  "sortNum": 36,
  "dependencies": ["HDFS", "KAFKA", "ZOOKEEPER", "HBASE"],
  "packageName": "atlas-2.4.0.tar.gz",
  "decompressPackageName": "atlas-2.4.0",
  "roles": [
    {
      "name": "AtlasServer",
      "label": "Atlas Server",
      "roleType": "master",
      "cardinality": "1+",
      "logFile": "${ATLAS_HOME}/logs/application.log",
      "jmxPort": 21000,
      "startRunner": {
        "timeout": "300",
        "program": "bin/atlas_server.sh",
        "args": ["start"]
      },
      "stopRunner": {
        "timeout": "300",
        "program": "bin/atlas_server.sh",
        "args": ["stop"]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/atlas_server.sh",
        "args": ["status"]
      },
      "externalLink": {
        "name": "Atlas UI",
        "label": "Atlas UI",
        "url": "http://${host}:21000"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "atlas-application.properties",
        "configFormat": "custom",
        "outputDirectory": "conf",
        "templateName": "atlas-application.properties.ftl",
        "includeParams": [
          "atlas_graph_storage_hostname",
          "atlas_kafka_bootstrap_servers",
          "atlas_server_port",
          "atlas_authentication_method_ldap_url"
        ]
      },
      {
        "filename": "atlas-env.sh",
        "configFormat": "custom",
        "outputDirectory": "conf",
        "templateName": "atlas-env.ftl",
        "includeParams": [
          "atlas_jvm_opts",
          "hadoop_conf_dir"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "atlas_graph_storage_hostname",
      "label": "图存储地址",
      "description": "HBase Zookeeper地址，用于存储图数据",
      "required": true,
      "type": "multiple",
      "separator": ",",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${zkQuorum}"
    },
    {
      "name": "atlas_kafka_bootstrap_servers",
      "label": "Kafka集群地址",
      "description": "Kafka地址，用于消息通知",
      "required": true,
      "type": "multiple",
      "separator": ",",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${kafkaBrokers}"
    },
    {
      "name": "atlas_server_port",
      "label": "服务端口",
      "description": "Atlas Server HTTP端口",
      "required": true,
      "type": "input",
      "value": "21000",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "21000"
    },
    {
      "name": "atlas_authentication_method_ldap_url",
      "label": "LDAP服务器地址",
      "description": "LDAP认证服务器地址",
      "required": false,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    }
  ]
}